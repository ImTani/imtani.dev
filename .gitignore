node_modules/
dist/
.wrangler/
*.local
*.log

# Wrangler secrets and any local environment. This repo is public.
.env
.env.*
.dev.vars
.dev.vars.*

# TypeScript project-reference build info
node_modules/.tmp/

# Baked at build time by tools/bake.ts. Regenerating it is deterministic, so
# there is nothing to preserve — and committing it would produce a diff of the
# entire grid on every build.
src/generated/

# Agent tooling and local machine state. This repo is public.
.agents/
.claude/
.codex/
.cursor/
.gemini/
.kiro/

# Generated by tools/writing/build.ts from articles/<slug>/article.md on
# every build, in CI as everywhere else. Nothing else lives in writing/.
/writing/

# The devlog editor's timestamped backups, written beside the article it edits.
.edit-backups/

# Drafts live in the private parent repo, at potpolio/articles/drafts/. One
# made here by mistake must never be committed to this public repo, and the
# build refuses to read it.
/articles/drafts/
