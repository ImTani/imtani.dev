{
  // Workers with static assets, not Pages. Cloudflare's own Pages docs now
  // carry a "Migrate to Workers" link and file the migration guide alongside
  // the ones for leaving Netlify and Vercel. One deploy serves the site and
  // the Godot proxy together.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imtani-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Not single-page-application: that returns index.html with a 200 for
    // every unmatched path, so a typo would serve the holding page and claim
    // it was the page asked for. This is a static multi-page site, so a miss
    // should be a miss. Becomes "404-page" once there is one worth showing.
    "not_found_handling": "none",
    // The Worker only runs for routes it claims; everything else is served
    // straight from the edge without invoking it.
    "run_worker_first": ["/api/*"]
  },

  // Served at the apex. workers.dev is off so there is one canonical URL and
  // nothing duplicate to index. The zone was already on Cloudflare with no A
  // record on the apex, which is what makes a Custom Domain possible here —
  // Cloudflare refuses to create one over an existing CNAME.
  "workers_dev": false,
  "routes": [{ "pattern": "imtani.dev", "custom_domain": true }],

  "observability": {
    "enabled": true
  }

  // No D1, no KV, no analytics binding. The site collects nothing, and the
  // absence of a storage binding is what makes that checkable rather than a
  // promise.
}
