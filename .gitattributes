# Normalise to LF in the repository. Authored on Windows, built in CI on Linux,
# deployed to a Linux runtime — without this the first CI run rewrites every
# file and the diff becomes unreadable.
* text=auto eol=lf

# Never touched by line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.ogg binary
*.wav binary
*.mp4 binary
*.webm binary
*.pdf binary

# Generated; keep it out of diffs and language statistics.
package-lock.json -diff linguist-generated
