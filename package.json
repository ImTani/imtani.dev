{
  "name": "imtani-dev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run bake",
    "dev": "vite",
    "build": "npm run bake && npm run devlog && tsc --build && vite build",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.ts\"",
    "bake": "node tools/bake.ts",
    "devlog": "node tools/devlog/build.ts",
    "devlog:media": "node tools/devlog/media.ts",
    "bench": "node tools/bench.ts",
    "pretypecheck": "npm run bake",
    "typecheck": "tsc --build --force",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "markdown-it": "^14.3.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.118.0"
  }
}
